# .dockerignore for root Dockerfile (Railway production deployment)
# This file is used by the root Dockerfile for production builds
# The frontend/Dockerfile uses its own context and doesn't need this file

# Version control
.git
.gitignore

# Development and IDE files
.vscode
.idea
.DS_Store
*.log

# Environment files
.env
.env.*

# Python cache and build artifacts
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.mypy_cache
*.egg-info
build/
dist/

# Node.js
**/node_modules

# Development data
dev_storage/
test/
testing/
presentation/

# Frontend build artifacts (development only - production uses pre-built frontend)
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Coverage and test artifacts
.nyc_output
coverage
.pytest_cache